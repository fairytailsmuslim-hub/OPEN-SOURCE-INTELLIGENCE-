# Server
PORT=5000
NODE_ENV=production
CLIENT_URL=https://yourdomain.com

# MongoDB
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/osint

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# Session / JWT
JWT_SECRET=minimum_64_char_random_string_here
SESSION_SECRET=another_64_char_random_string

# Audit log signing (HMAC)
AUDIT_HMAC_KEY=32_byte_hex_key_for_hmac_signing
MAXMIND_LICENSE_KEY=your_key_here
# OSINT API Tokens (SERVER-SIDE ONLY - never expose)
SHODAN_API_KEY=your_shodan_key
CENSYS_API_ID=your_censys_id
CENSYS_API_SECRET=your_censys_secret

# Geofencing
ALLOWED_COUNTRIES=PK,PS
GEOFENCE_STRICT=false